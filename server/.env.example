NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://wedding:wedding@localhost:5432/wedding_organizer
# change me: at least 32 characters, random in any real deployment
JWT_SECRET=change-me-change-me-change-me-change-me
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Wedding Organizer <no-reply@wedding.local>"
APP_BASE_URL=http://localhost:4200
REMINDER_DAYS_BEFORE=3
CRON_ENABLED=true
CONTACT_TO=hello@wedding-organizer.local
# Number of reverse-proxy hops in front of the API (0 = none; use the socket IP). Set to 1 behind one proxy.
TRUST_PROXY=0
# Optional SMTP auth (leave empty for Mailpit); SMTP_SECURE=true for implicit TLS (port 465)
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
