generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WeddingStatus {
  ACTIVE
  ARCHIVED
}

enum MemberRole {
  TEAM_MEMBER
}

enum MemberStatus {
  ACTIVE
  REVOKED
}

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  TASK_DEADLINE_REMINDER
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique // stored lowercased
  passwordHash String
  passwordChangedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWeddings Wedding[]
  memberships   WeddingMember[]
  assignedTasks Task[]
  notifications Notification[]
}

model Wedding {
  id           String        @id @default(uuid())
  ownerId      String // BR-01: exactly one owner
  coupleNames  String
  weddingDate  DateTime      @db.Date
  location     String
  totalBudget  Decimal       @db.Decimal(12, 2)
  rsvpDeadline DateTime      @db.Date
  status       WeddingStatus @default(ACTIVE)
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  owner         User            @relation(fields: [ownerId], references: [id])
  members       WeddingMember[]
  guests        Guest[]
  tasks         Task[]
  expenses      Expense[]
  suppliers     Supplier[]
  scheduleItems ScheduleItem[]

  @@index([ownerId])
}

model WeddingMember {
  id        String       @id @default(uuid())
  weddingId String
  userId    String
  role      MemberRole   @default(TEAM_MEMBER)
  status    MemberStatus @default(ACTIVE)
  revokedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([weddingId, userId]) // BR-02
  @@index([userId])
}

model Guest {
  id                  String     @id @default(uuid())
  weddingId           String
  name                String
  email               String
  rsvpStatus          RsvpStatus @default(PENDING)
  dietaryRequirements String?
  respondedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  wedding    Wedding     @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  invitation Invitation?

  @@index([weddingId])
  @@index([weddingId, rsvpStatus])
}

model Invitation {
  id             String         @id @default(uuid())
  guestId        String         @unique // BR-05: one invitation per guest
  tokenHash      String         @unique // SHA-256 of the token; the token itself is never stored
  deliveryStatus DeliveryStatus @default(PENDING)
  attemptCount   Int            @default(0)
  lastSentAt     DateTime?
  lastError      String?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([deliveryStatus])
}

model Task {
  id                   String       @id @default(uuid())
  weddingId            String
  assigneeId           String?
  title                String
  description          String?
  dueDate              DateTime @db.Date
  priority             TaskPriority @default(MEDIUM)
  status               TaskStatus   @default(TODO)
  progressNotes        String?
  completedAt          DateTime?
  sourceTemplateItemId String? // informational, no FK (FR-38)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  wedding       Wedding        @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  assignee      User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([weddingId])
  @@index([assigneeId])
  @@index([weddingId, status])
}

model ChecklistTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ChecklistTemplateItem[]
}

model ChecklistTemplateItem {
  id                String       @id @default(uuid())
  templateId        String
  title             String
  description       String?
  priority          TaskPriority @default(MEDIUM)
  daysBeforeWedding Int
  sortOrder         Int
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sortOrder])
  @@index([templateId])
}

model Expense {
  id           String   @id @default(uuid())
  weddingId    String
  description  String
  category     String
  agreedAmount Decimal  @db.Decimal(12, 2)
  dueDate      DateTime @db.Date
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wedding  Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([weddingId])
}

model Payment {
  id          String   @id @default(uuid())
  expenseId   String
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @db.Date
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model Supplier {
  id          String   @id @default(uuid())
  weddingId   String
  name        String
  category    String
  contactInfo String?
  quotedPrice Decimal? @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId])
}

model ScheduleItem {
  id        String   @id @default(uuid())
  weddingId String
  title     String
  startTime DateTime
  endTime   DateTime
  location  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wedding Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@index([weddingId, startTime])
}

model Notification {
  id           String              @id @default(uuid())
  userId       String
  taskId       String
  type         NotificationType
  channel      NotificationChannel
  scheduledAt  DateTime
  status       NotificationStatus  @default(PENDING)
  sentAt       DateTime?
  readAt       DateTime?
  attemptCount Int                 @default(0)
  lastError    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, type, channel, scheduledAt]) // NFR-16
  @@index([userId, channel])
  @@index([status, scheduledAt])
}
